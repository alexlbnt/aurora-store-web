      "name": "Novo pedido",
      "short_name": "Novo pedido",
      "url": "/admin/sales/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Novo cliente",
      "short_name": "Novo cliente",
      "url": "/admin/customers/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Produtos e estoque",
      "short_name": "Produtos",
      "url": "/admin/products",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
